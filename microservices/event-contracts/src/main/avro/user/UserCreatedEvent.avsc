{
  "namespace": "org.example.events.user",
  "type": "record",
  "name": "UserCreatedEvent",
  "fields": [
    { "name": "userId", "type": "string" },
    { "name": "username", "type": "string" },
    { "name": "role", "type": ["null", "string"], "default": null },
    { "name": "createdAt", "type": "long", "logicalType": "timestamp-millis" }
  ]
}